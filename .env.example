PROJECT_NAME="TaskFlow Enterprise API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - SQLite by default for easy local development
DATABASE_URL="sqlite+aiosqlite:///./taskflow.db"
# For PostgreSQL in Docker:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/taskflow_db"
DATABASE_ECHO=False

# CORS
BACKEND_CORS_ORIGINS=["*"]
